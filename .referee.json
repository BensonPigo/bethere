{
  "version": 1,
  "base": "origin/main",
  "gates": [
    "test",
    "crap",
    "mutation"
  ],
  "sources": [
    "**/*.go"
  ],
  "tests": [
    "**/*_test.go"
  ],
  "exclude": [
    "tools/",
    "vendor/",
    "node_modules/",
    "web/",
    ".claude/"
  ],
  "test": {
    "command": [
      "go",
      "test",
      "./..."
    ]
  },
  "crap": {
    "threshold": 12,
    "inspector": [
      "python",
      "tools/referee/inspectors/go.py",
      "functions",
      "--coverage-scope",
      "module"
    ]
  },
  "mutation": {
    "kill_rate_threshold": 80,
    "reach_rate_threshold": 50,
    "exclude_mutators": [],
    "equivalents_file": ".referee-equivalents.json",
    "inspector": [
      "python",
      "tools/referee/inspectors/go.py",
      "mutants",
      "--workers",
      "4",
      "--coverage-scope",
      "module"
    ]
  }
}
