#!/usr/bin/env bash
# A stand-in for gcloud in ops/gcp/test/run.sh: logs every call and answers
# from the state in $FAKE (vm, vm.zone, meta.<key>, missing, nobackup).
echo "gcloud $*" >> "$FAKE/calls"
args=" $* "
has() { [[ "$args" == *"$1"* ]]; }
vm_exists() { [ -e "$FAKE/vm" ]; }
case "$args" in
  *" compute instances list "*)
    vm_exists || exit 0
    if has "zone.basename(),status"; then echo "bethere-1 $(cat "$FAKE/vm.zone") RUNNING 2026-10-01T00:00:00"
    elif has "--filter=name="; then cat "$FAKE/vm.zone"
    else echo bethere-1; fi ;;
  *" auth print-access-token "*) echo token ;;
  *" compute instances describe "*" --format=value(status) "*) cat "$FAKE/vm.status" 2>/dev/null || echo RUNNING ;;
  *" compute instances start "*) echo RUNNING > "$FAKE/vm.status" ;;
  *" compute instances stop "*) echo TERMINATED > "$FAKE/vm.status" ;;
  # Monitoring: the check is one line "name host" in $FAKE/check; each alert
  # is $FAKE/policies/<id> (its JSON) with its state in <id>.enabled.
  *" monitoring uptime list-configs "*)
    [ -e "$FAKE/nochecklist" ] && exit 1
    if has "value(monitoredResource"; then sed 's/.* //' "$FAKE/check" 2>/dev/null; else cat "$FAKE/check" 2>/dev/null; fi; true ;;
  *" monitoring uptime create "*)
    [ -e "$FAKE/failcheck" ] && { echo "ERROR: quota" >&2; exit 1; }
    echo "projects/test-proj/uptimeCheckConfigs/chk$RANDOM $(sed -n 's/.*host=\([^,]*\),.*/\1/p' <<<"$args")" > "$FAKE/check" ;;
  *" monitoring uptime delete "*) rm -f "$FAKE/check" ;;
  *" monitoring policies list "*)
    [ -e "$FAKE/nolist" ] && exit 1
    for f in "$FAKE"/policies/p*; do
      case "$f" in *.enabled|*"p*") continue ;; esac
      if has "value(enabled)"; then cat "$f.enabled"; else echo "projects/test-proj/alertPolicies/${f##*/}"; fi
    done ;;
  *" monitoring policies create "*)
    mkdir -p "$FAKE/policies"; id="p$RANDOM"
    cp "$(sed -n 's/.*--policy-from-file=\([^ ]*\).*/\1/p' <<<"$args")" "$FAKE/policies/$id"
    grep -q '"enabled": true' "$FAKE/policies/$id" && echo True > "$FAKE/policies/$id.enabled" || echo False > "$FAKE/policies/$id.enabled" ;;
  *" monitoring policies delete "*) id="$(sed -n 's#.*alertPolicies/\([a-z0-9]*\).*#\1#p' <<<"$args")"; rm -f "$FAKE/policies/$id" "$FAKE/policies/$id.enabled" ;;
  *" monitoring policies update "*)
    id="$(sed -n 's#.*alertPolicies/\([a-z0-9]*\).*#\1#p' <<<"$args")"
    if has "--no-enabled"; then echo False; else echo True; fi > "$FAKE/policies/$id.enabled" ;;
  *" compute instances describe "*)
    key="$(sed -n 's/.*metadata\.items\.\([a-z-]*\).*/\1/p' <<<"$args")"
    cat "$FAKE/meta.$key" 2>/dev/null || true ;;
  *" compute instances delete "*) [ -e "$FAKE/faildelete" ] && { echo "ERROR: timeout" >&2; exit 1; }; rm -f "$FAKE/vm" ;;
  *" compute instances create "*) [ -e "$FAKE/failcreate" ] && { echo "ERROR: ZONE_RESOURCE_POOL_EXHAUSTED" >&2; exit 1; }; touch "$FAKE/vm"; sed -n 's/.*--zone \([a-z0-9-]*\).*/\1/p' <<<"$args" > "$FAKE/vm.zone" ;;
  *" compute instances add-metadata "*) ;;
  *" compute addresses describe "*) [ -e "$FAKE/noaddress" ] && { echo "ERROR: not found" >&2; exit 1; }; echo 10.0.0.1 ;;
  *" compute machine-types describe "*)
    has "--zone asia-east1-a " || has "--zone asia-east1-b " || has "--zone asia-east1-c " || exit 1 ;;
  *" compute disks list "*) ;;
  *" compute ssh "*)
    # sshfail: how many more ssh calls fail, as IAP does right after a create.
    n="$(cat "$FAKE/sshfail" 2>/dev/null || echo 0)"
    if [ "$n" -gt 0 ]; then echo $((n - 1)) > "$FAKE/sshfail"; echo "ERROR: 4003: failed to connect to backend" >&2; exit 255; fi
    printf 'version=%s\nBETHERE_MAINTENANCE=0\n' "$(cat "$FAKE/deployed" 2>/dev/null)" ;;
  *" storage objects describe "*)
    for m in $(cat "$FAKE/missing" 2>/dev/null); do has "$m" && exit 1; done ;;
  *" storage ls "*)
    if has "-backups/bethere/"; then
      if [ -e "$FAKE/nobackup" ]; then echo "ERROR: (gcloud.storage.ls) One or more URLs matched no objects." >&2; exit 1; fi
      if [ -e "$FAKE/noperm" ]; then echo "ERROR: (gcloud.storage.ls) HTTPError 403: denied" >&2; exit 1; fi
      echo "gs://x-backups/bethere/generations/"
    else printf 'gs://x/bethere/aaa-20261001000000/\ngs://x/bethere/bbb-20261027000000/\n'; fi ;;
esac
exit 0
